# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
env/
vtts/                 # ← ה-venv של ה-TTS

# Build / dist artifacts
build/
dist/
*.egg-info/

# Audio generated by TTS worker
static/tts/*
!static/tts/.gitkeep  # השאירי את התיקייה בגיט

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Optional: local caches (אם יש בתוך הריפו)
**/.cache/
**/huggingface/

# Optional: secrets (אם תשתמשי בקובץ כזה)
#.env
